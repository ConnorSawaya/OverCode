{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["../app/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts", "package.json"]
}
